    {
      "name": "AMOUNT IN WORD",
      "formula": "{@AMOUNT IN WORD}",
      "text": "//{DataTable1.AMOUNT_DOLLAR}\r\nnumbervar RmVal:=0; \r\nnumbervar Amt:=0; \r\nnumbervar pAmt:=0; \r\nstringvar InWords :=\u0022\u0022; \r\nAmt :=tonumber(replace(totext(6500),\u0022/-\u0022,\u0022\u0022)); \r\n\r\nif Amt \u003E 1000000 then RmVal := truncate(Amt/1000000); \r\nif Amt = 1000000 then RmVal := 1; \r\nif RmVal \u003E= 1 then \r\n    InWords := InWords \u002B \u0022 \u0022 \u002B towords(RmVal,0) \u002B \u0022 Million\u0022;\r\n\r\nAmt := Amt - (Rmval * 1000000); \r\nRmVal := 0;\r\n\r\nif Amt \u003E 1000 then RmVal := truncate(Amt/1000); \r\nif Amt = 1000 then RmVal := 1; \r\nif RmVal \u003E=1 then \r\n    InWords := InWords \u002B \u0022 \u0022 \u002B towords(RmVal,0) \u002B \u0022 Thousand \u0022;\r\n\r\nAmt := Amt - (Rmval * 1000); \r\nRmVal := 0;\r\n\r\nif Amt \u003E 100 then RmVal := truncate(Amt/100); \r\nif Amt = 100 then RmVal := 1; \r\nif RmVal \u003E=1 then \r\n    InWords := InWords \u002B \u0022 \u0022 \u002B towords(RmVal,0) \u002B \u0022 Hundred \u0022;\r\n\r\nAmt := Amt - (Rmval * 100);\r\nRmVal := 0;\r\n\r\nif Amt \u003E 0 then InWords := InWords \u002B  towords(truncate(Amt),0)\u002B \u0022 \u0022; \r\n\r\nInWords := InWords \u002B \u0022 DOLLARS\u0022;\r\n\r\npAmt := (Amt - truncate(Amt)) * 100; \r\n\r\nif pAmt \u003E 0 then \r\n    InWords := InWords \u002B \u0022 \u0026 \u0022 \u002B towords(pAmt,0) \u002B \u0022 Cents\u0022;\r\n\r\n\r\nInWords := \u0022US DOLLAR \u0022 \u002B InWords \u002B \u0022 only\u0022; \r\n\r\nUPPERCASE(ProperCase (InWords))",
      "type": "StringField"
    },

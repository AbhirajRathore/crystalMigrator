{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "presentation": { "group": "run", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "backend: run",
      "type": "shell",
      "command": "dotnet run --urls http://127.0.0.1:5249",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "presentation": { "group": "run", "panel": "dedicated", "reveal": "always" },
      "problemMatcher": []
    },
    {
      "label": "Run All (frontend + backend)",
      "dependsOn": ["frontend: dev", "backend: run"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}

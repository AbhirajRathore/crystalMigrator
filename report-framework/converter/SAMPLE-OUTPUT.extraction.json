    { "name": "ShipCharge", "formula": "{@ShipCharge}", "text": "If IsNull({VIW_SALE_MASTER_DETAIL.SHIPPING_CHARGES}) Then 'COLLECT' Else {VIW_SALE_MASTER_DETAIL.SHIPPING_CHARGES}", "type": "StringField" }

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReportMigrator.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates are copied next to the app so they can be served/used at runtime. -->
    <Content Update="Reports\templates\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
